// Prisma Schema - INFUT
// Issues #12 (User table), #18 (Profile fields), #22 (Pelada table)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  sport        String?
  position     String?
  photoUrl     String?  @map("photo_url")
  region       String?  // Para o mapa de localização (Sprint 3)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relações
  organizedPeladas Pelada[] @relation("organizer")
  participations   Participant[]

  @@map("users")
}

model Pelada {
  id             String   @id @default(uuid())
  title          String
  sport          String
  dateTime       DateTime @map("date_time")
  location       String
  locationAddress String?  @map("location_address")
  price          Float?
  isRecurring    Boolean  @default(false) @map("is_recurring")
  recurrenceDay  String?  @map("recurrence_day") // 'monday', 'tuesday', etc.
  maxPlayers     Int?     @map("max_players")
  organizerId    String   @map("organizer_id")
  inviteCode     String?  @unique @map("invite_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relações
  organizer User @relation("organizer", fields: [organizerId], references: [id])
  participants Participant[]

  @@map("peladas")
}

model Participant {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  peladaId      String   @map("pelada_id")
  status        String   @default("CONFIRMED") // Para uso futura na US06 (RSVP)
  absenceReason String?  @map("absence_reason") // Motivo opcional
  paid          Boolean  @default(false) // Indica se o participante já pagou (US08)
  
  // Estatísticas do jogador na pelada (US10)
  goals         Int      @default(0)
  assists       Int      @default(0)
  defenses      Int      @default(0)

  // Votação do MVP (US10)
  votedForMvpId String?  @map("voted_for_mvp_id")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  pelada Pelada @relation(fields: [peladaId], references: [id])
  
  // Relações do MVP
  votedForMvp   Participant?  @relation("MvpVotes", fields: [votedForMvpId], references: [id])
  receivedVotes Participant[] @relation("MvpVotes")

  @@unique([userId, peladaId])
  @@map("participants")
}
